<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.infinevo</groupId>
    <artifactId>infinevo-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>payroll</artifactId>
  <name>Infinevo :: payroll</name>
  <description>Payroll module: pay runs, tax, claims, statutory reporting.</description>

  <dependencies>
      <dependency>
        <groupId>com.infinevo</groupId>
        <artifactId>core</artifactId>
      </dependency>
      <dependency>
        <groupId>com.infinevo</groupId>
        <artifactId>shared</artifactId>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter</artifactId>
      </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-module-boundary</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.infinevo:hrms</exclude>
                  </excludes>
                  <message>
MODULE BOUNDARY VIOLATION in 'payroll'.
payroll must not depend on hrms. A customer can buy Payroll alone, so hrms classes
must not be reachable from it.
See docs/target-state/03-code-structure.md section 3. Cross-module data passes
through core.pay_input, never through a direct dependency.
                  </message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
