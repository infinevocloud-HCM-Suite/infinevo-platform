<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.infinevo</groupId>
    <artifactId>infinevo-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>shared</artifactId>
  <name>Infinevo :: shared</name>
  <description>Cross-cutting primitives only: tenant context, error envelope, money. Nothing with domain meaning.</description>

  <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-web</artifactId>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-security</artifactId>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-jdbc</artifactId>
      </dependency>
      <!--
        W-22.1: compile scope, not test. The audit trail maps core.audit_log with JPA and
        captures changes through a Hibernate event listener, so the entity, the repository
        and the listener all need this on the main classpath. It was test-scoped for W-04,
        which only needed AbstractIntegrationTest.
      -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-data-jpa</artifactId>
      </dependency>
      <dependency>
        <groupId>com.azure</groupId>
        <artifactId>azure-storage-queue</artifactId>
      </dependency>
      <!-- W-60: Observability Primitives -->
      <dependency>
        <groupId>net.logstash.logback</groupId>
        <artifactId>logstash-logback-encoder</artifactId>
      </dependency>
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-registry-prometheus</artifactId>
      </dependency>
      <!-- W-53: Redis distributed cache -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-data-redis</artifactId>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-pool2</artifactId>
      </dependency>
      <!--
        W-11.2: @RequiresAction is enforced by an @Aspect (RequiresActionAspect). AspectJ already
        arrives transitively through spring-boot-starter-data-jpa; declared here because this module
        now depends on it directly, and a transitive path is not a contract.
      -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-aop</artifactId>
      </dependency>
      <!-- W-04: Testcontainers for integration test infrastructure -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>postgresql</artifactId>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>junit-jupiter</artifactId>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.security</groupId>
        <artifactId>spring-security-test</artifactId>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <scope>test</scope>
      </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>${project.basedir}/src/test/resources</directory>
      </testResource>
      <testResource>
        <directory>${project.basedir}/../../../infra/postgres</directory>
        <targetPath>db/provision</targetPath>
        <includes>
          <include>*.sql</include>
        </includes>
      </testResource>
      <!--
        W-10: the dev realm export, on the test classpath so LoginFlowIT can import it into a
        Keycloak container. The test asserts against the realm the local stack actually runs, so
        a mapper or a user id changed there fails the test rather than only breaking `docker
        compose up` for whoever pulls next.
      -->
      <testResource>
        <directory>${project.basedir}/../../../infra/docker/keycloak</directory>
        <targetPath>keycloak</targetPath>
        <includes>
          <include>*.json</include>
        </includes>
      </testResource>
      <testResource>
        <directory>${project.basedir}/../migration/src/main/resources/db/migration</directory>
        <targetPath>db/migration</targetPath>
        <includes>
          <include>**/*.sql</include>
        </includes>
      </testResource>
    </testResources>
    <plugins>
      <!--
        W-04: Export test classes as a test-jar so other modules can import
        shared test infrastructure (AbstractIntegrationTest, initializers)
        via <type>test-jar</type> dependency.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals><goal>test-jar</goal></goals>
            <configuration>
              <!--
                W-22.1: the audit fixtures stay out of the test-jar. AuditedProbe is an
                @Entity mapping core.audited_probe, a table no migration creates. Every
                module scans com.infinevo for entities, so shipping it would put a mapping
                to a non-existent table on the test classpath of core, hrms, payroll,
                worker and migration. Harmless while ddl-auto is none, a trap the day
                anything validates mappings. Only com/infinevo/shared/test/** is shared.
              -->
              <!--
                W-10 adds two more for the same reason: IdentityTestApp and
                ResourceServerConfigTest.TestApp are @SpringBootApplication classes, and every
                module scans com.infinevo. Shipping them would put a second application class on
                the test classpath of core, hrms, payroll, worker and migration.
              -->
              <excludes>
                <exclude>com/infinevo/shared/audit/**</exclude>
                <exclude>com/infinevo/shared/identity/**</exclude>
                <exclude>com/infinevo/shared/security/**</exclude>
                <!-- W-11.2: PermissionReplicaIT and PermissionRlsIT carry nested @SpringBootApplication classes. -->
                <exclude>com/infinevo/shared/authz/**</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
