<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.infinevo</groupId>
    <artifactId>infinevo-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>worker</artifactId>
  <name>Infinevo :: worker (batch role)</name>
  <description>Batch role. Consumes the queue and runs scheduled jobs with cluster locking. Health endpoint only.</description>

  <dependencies>
    <dependency><groupId>com.infinevo</groupId><artifactId>core</artifactId></dependency>
    <dependency><groupId>com.infinevo</groupId><artifactId>hrms</artifactId></dependency>
    <dependency><groupId>com.infinevo</groupId><artifactId>payroll</artifactId></dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- W-02: the local stack proves app connects to Postgres as app_user, never as
         owner. No entities yet - W-07 onward add those. Schema is owned by Flyway
         (W-06); ddl-auto is banned permanently (D-09, DEBT-002). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.infinevo.worker.InfinevoWorkerApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
