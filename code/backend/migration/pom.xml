<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.infinevo</groupId>
    <artifactId>infinevo-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>migration</artifactId>
  <name>Infinevo :: migration</name>
  <description>
    Flyway migration runner. Connects as migration_user, applies the global script
    set in schema order (reference, core, hrms, payroll), and exits. History table
    lives in the migration schema. See README.md for script conventions.
  </description>

  <dependencies>
    <!-- Spring Boot base - provides autoconfiguration, lifecycle, and Flyway starter wiring -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- Spring Boot JDBC starter - provides DataSourceAutoConfiguration required for Flyway auto-configuration -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- Flyway core - migration engine -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <!-- Flyway 10.x requires the database-specific module separately (W-06 spec §4 file 1, risk §10) -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- PostgreSQL JDBC driver -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      shared test-jar: provides PostgresTestContainerInitializer and the
      db/provision/*.sql scripts (via shared/pom.xml:55-61 testResource mapping).
      Dependency edge: migration -> shared (test-jar, test scope). One direction only.
      The reverse edge (shared -> migration) is NOT added - that would create a Maven cycle.
    -->
    <dependency>
      <groupId>com.infinevo</groupId>
      <artifactId>shared</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.infinevo</groupId>
      <artifactId>shared</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <!--
      Testcontainers: test-scope deps from the shared test-jar are NOT transitive.
      Declare them explicitly so PostgreSQLContainer resolves at test compile/runtime.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Copies worker/pom.xml:44-50 exactly - enables java -jar and mvn spring-boot:run -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.infinevo.migration.MigrationApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
