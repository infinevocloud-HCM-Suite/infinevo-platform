    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@reduxjs/toolkit": "^2.3.0",
    "antd": "^5.21.6",
    "axios": "^1.7.7",
    "formik": "^2.4.9",
    "keycloak-js": "^25.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
