{
  "name": "infinevo-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One React application for Core, HRMS and Payroll. Routes register per entitlement.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
