{
  "permissions": {
    "allow": [
      "Bash(az monitor log-analytics query *)",
      "Bash(az containerapp revision list *)",
      "Bash(az containerapp revision show *)",
      "Bash(az containerapp job execution list *)",
      "Bash(az containerapp job execution show *)",
      "Bash(az containerapp job show *)",
      "Bash(az containerapp job list *)",
      "Bash(az containerapp logs show *)",
      "Bash(az containerapp list *)",
      "Bash(az containerapp show *)",
      "Bash(az deployment operation sub list *)",
      "Bash(az deployment sub list *)",
      "Bash(az deployment group list *)",
      "Bash(az deployment group show *)",
      "Bash(az postgres flexible-server show *)",
      "Bash(az role assignment list *)",
      "Bash(az resource list *)",
      "Bash(az account show *)",
      "Bash(az bicep lint *)",
      "Bash(az cognitiveservices account list-models *)",
      "Bash(gh run watch *)",
      "Bash(docker system df)",
      "Bash(npm run typecheck)",
      "Bash(git rm *)",
      "Bash(git add *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-merge.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-app.mjs\"",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-log.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
