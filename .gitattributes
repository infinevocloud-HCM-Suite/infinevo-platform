# Normalise line endings so a mixed Windows/macOS/Linux team does not produce
# whole-file diffs. Text is stored LF in the repository and checked out native.
* text=auto

# Always LF — these are executed by tools that care
*.mjs   text eol=lf
*.sh    text eol=lf
mvnw    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile* text eol=lf

# Always CRLF — Windows batch files
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binary
*.xlsx  binary
*.png   binary
*.jpg   binary
*.jar   binary
*.exe   binary
