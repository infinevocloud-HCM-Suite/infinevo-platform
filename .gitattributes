# Normalise line endings so a mixed Windows/macOS/Linux team does not produce
# whole-file diffs. Text is stored LF in the repository and checked out native.
* text=auto

# Always LF — these are executed by tools that care
*.mjs   text eol=lf
*.sh    text eol=lf
*.sql   text eol=lf
mvnw    text eol=lf
# Spotless (W-03) resolves line endings via GIT_ATTRIBUTES. The dev image COPYs
# code/backend/ without .git, so that policy cannot resolve inside the container
# and falls back to platform-native LF - making a CRLF working tree fail
# spotless:check on Windows only. Pinning LF fixes the cause.
*.java  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
# Leading * on purpose: the files are named dev.Dockerfile.backend /
# dev.Dockerfile.frontend, which a bare Dockerfile* pattern never matched.
*Dockerfile* text eol=lf

# Always CRLF — Windows batch files
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binary
*.xlsx  binary
*.png   binary
*.jpg   binary
*.jar   binary
*.exe   binary
