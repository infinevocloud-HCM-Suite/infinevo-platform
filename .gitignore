# ---------------------------------------------------------------------------
# The four frozen applications live in legacy/ as committed snapshots.
# They are no longer cloned separately - CONTRIBUTING.md section 1.
# ---------------------------------------------------------------------------

# Harness working files, under .claude/ with the harness itself.
# Findings and session logs ARE tracked: docs/target-state/README.md cites them,
# and .claude/work/active-work.md is the live project state everyone reads first.
# Only transient machine-local material is ignored.
.claude/outputs/.verify-cache/

# Dependencies
node_modules/

# Local tooling binaries (not project artifacts)
Trae-Setup-x64.exe

# Build output
code/backend/**/target/
code/frontend/node_modules/
code/frontend/dist/

# Merge receipts: machine-local proof that check-done.mjs passed HERE, at this commit.
# Never committed - a shared receipt would let one machine's pass unlock everyone
# else's merge, which is the whole thing the gate exists to prevent.
.claude/outputs/.merge-receipts/

# Local port overrides for the dev stack (each developer, never committed)
infra/docker/.env

# Session transcripts: the Stop hook rewrites these every turn, so they conflict on
# every rebase and merge - three times on 2026-09-13 alone. The investigation findings
# beside them stay tracked; a running commentary of one machine's session does not
# need to be.
.claude/outputs/*-session-*.md
