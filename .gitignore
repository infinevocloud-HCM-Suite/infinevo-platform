# ---------------------------------------------------------------------------
# Application repos
# Today these are 4 independent git repos with their own .git directories.
# They are ignored here so root git does not create gitlinks/submodules.
# When the repo migration is scoped, these entries are removed and each app
# is brought in with `git subtree add`. See .claude/skills/sync-upstream/
# ---------------------------------------------------------------------------
/HRMS_Backend/
/HRMS_Frontend/
/Payroll-Bend-SBoot/
/Payroll-Fend-react/

# Agent working files.
# Findings and session logs ARE tracked: docs/target-state/README.md cites them,
# and active-work.md is the live project state every developer reads first.
# Only transient and duplicated material is ignored.
agents/outputs/.verify-cache/
agents/outputs/target-state/

# Dependencies
node_modules/

# Local tooling binaries (not project artifacts)
Trae-Setup-x64.exe
