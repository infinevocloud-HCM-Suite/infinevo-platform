# Copy to .env if a host port on your machine is already taken.
#   cp infra/docker/.env.example infra/docker/.env
#
# Only the HOST side changes. Containers always talk to each other on the standard
# ports over the compose network, so nothing else needs adjusting.
#
# Find what holds a port:
#   Windows   netstat -ano | findstr :6379
#   macOS     lsof -i :6379

# POSTGRES_PORT=5432
# REDIS_PORT=6379
# QUEUE_PORT=5672
# QUEUE_UI_PORT=15672
# BLOB_PORT=10000
# MAIL_SMTP_PORT=1025
# MAIL_UI_PORT=8025
# KEYCLOAK_PORT=8081
# APP_PORT=8080
# WEB_PORT=5173
# WORKER_PORT=8082
